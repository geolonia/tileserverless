{
  "name": "tileserverless",
  "description": "A Serverless Tile Server Kit.",
  "version": "2.7.1",
  "main": "serverless.yml",
  "license": "MIT",
  "scripts": {
    "test": "jest --coverage",
    "build": "tsc",
    "deploy:dev": "yarn build && sls deploy --stage=dev",
    "deploy:v1": "yarn build && sls deploy --stage=v1"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/__test__/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.114",
    "@types/jest": "^29.5.0",
    "@types/node": "^16",
    "aws-sdk": "^2.1348.0",
    "jest": "^29.5.0",
    "serverless": "^3.29.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.3"
  },
  "peerDependencies": {
    "aws-sdk": "^2"
  },
  "dependencies": {
    "@mapbox/mbtiles": "^0.12.1"
  }
}
